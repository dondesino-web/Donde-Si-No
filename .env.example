# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.
# En Vercel, estas variables se cargan en Project Settings → Environment Variables.

# Base de datos (Turso / libSQL). En local basta con un archivo SQLite.
TURSO_DATABASE_URL=file:local.db
# Solo en producción: token de la base de datos en Turso.
TURSO_AUTH_TOKEN=

# Vercel Blob (fotos). Vacío en local: las fotos se guardan en `public/uploads/`.
# Si quieres probar Blob en local, usa un store de desarrollo: nunca el token de producción.
BLOB_READ_WRITE_TOKEN=

# --- Fase 2: panel de administración ---
# Hash scrypt de la contraseña del administrador (se generará con `npm run admin:hash`).
ADMIN_PASSWORD_HASH=
# Secreto aleatorio de 32+ bytes para firmar la cookie de sesión.
SESSION_SECRET=
# Secreto aleatorio para invalidar la caché ISR de Vercel al guardar cambios.
ISR_BYPASS_TOKEN=

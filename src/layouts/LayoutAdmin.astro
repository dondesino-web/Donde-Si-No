---
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
	titulo: string;
	/** Oculta la barra de navegación (pantalla de login). */
	sinNavegacion?: boolean;
}

const { titulo, sinNavegacion = false } = Astro.props;

/** `prefijos` agrupa las pantallas internas (editar un producto cuenta como «Carta»). */
const SECCIONES = [
	{ href: '/admin', texto: 'Inicio', prefijos: [] },
	{ href: '/admin/carta', texto: 'Carta', prefijos: ['/admin/producto'] },
	{ href: '/admin/carga-rapida', texto: 'Carga rápida', prefijos: [] },
	{ href: '/admin/promociones', texto: 'Promos', prefijos: ['/admin/promocion'] },
	{ href: '/admin/menu-del-dia', texto: 'Menú del día', prefijos: [] },
	{ href: '/admin/fotos', texto: 'Fotos', prefijos: [] },
	{ href: '/admin/estadisticas', texto: 'Estadísticas', prefijos: [] },
	{ href: '/admin/qr', texto: 'QR', prefijos: [] },
	{ href: '/admin/local', texto: 'Local', prefijos: [] },
];
const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';
const estaEn = (base: string) => ruta === base || ruta.startsWith(`${base}/`);
const actual = SECCIONES.find((s) => (s.href === '/admin' ? ruta === '/admin' : [s.href, ...s.prefijos].some(estaEn)));
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{titulo} · Panel · Dónde Si No</title>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="manifest" href="/panel.webmanifest" />
		<meta name="theme-color" content="#0b2a6f" />
		<link rel="apple-touch-icon" href="/marca/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Panel" />
	</head>
	<body class="admin">
		<a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
		{
			!sinNavegacion && (
				<header class="admin-barra no-imprimir">
					<span class="admin-barra__seccion">{actual?.texto ?? 'Panel'}</span>
					<button type="button" class="admin-barra__menu" aria-expanded="false" aria-controls="menu-panel">Menú</button>
					<nav aria-label="Panel" class="admin-barra__nav" id="menu-panel">
						{SECCIONES.map((s) => <a href={s.href} aria-current={s === actual ? 'page' : undefined}>{s.texto}</a>)}
						<a href="/" target="_blank" rel="noopener noreferrer">Ver carta</a>
						<form method="post" action="/admin/salir">
							<button type="submit" class="boton boton--secundario admin-barra__salir">Salir</button>
						</form>
					</nav>
				</header>
			)
		}
		<main id="contenido" class="admin-contenido">
			<slot />
		</main>
	</body>
</html>

<script>
	import '../scripts/panelInstalable.ts';
</script>

<script>
	// Sin JavaScript el menú queda desplegado: el dueño nunca pierde la navegación.
	const barra = document.querySelector<HTMLElement>('.admin-barra');
	const boton = barra?.querySelector<HTMLButtonElement>('.admin-barra__menu');
	if (barra && boton) {
		barra.dataset.js = '';
		boton.addEventListener('click', () => {
			const abierto = boton.getAttribute('aria-expanded') !== 'true';
			boton.setAttribute('aria-expanded', String(abierto));
			barra.toggleAttribute('data-abierto', abierto);
		});
	}
</script>

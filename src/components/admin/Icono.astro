export type NombreIcono = keyof typeof ICONOS;

interface Props {
	nombre: NombreIcono;
	tamano?: number;
}

const { nombre, tamano = 20 } = Astro.props;
---

<svg class="icono" width={tamano} height={tamano} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={ICONOS[nombre]} />

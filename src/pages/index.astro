---
// Portada provisional hasta que la carta pública esté lista (Fase 1 del plan).
import '../styles/global.css';
---

<html lang="es-CL">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/marca/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Dónde Si No · Comida rápida en Chocalán, Melipilla</title>
		<meta name="description" content="Desayunos, colaciones y comida rápida en Ruta G60 Km 3, Chocalán, Melipilla. ¡Aquí hay sabor!" />
	</head>
	<body>
		<main class="provisional">
			<img src="/marca/logo-160.webp" srcset="/marca/logo-160.webp 1x, /marca/logo-320.webp 2x" width="160" height="160" alt="" />
			<h1>Dónde Si No</h1>
			<p class="eslogan">¡Aquí hay sabor!</p>
			<p>Estamos preparando nuestra carta digital.</p>
			<p><a href="tel:+56988860939">Llámanos: +56 9 8886 0939</a></p>
		</main>
	</body>
</html>

<style>
	.provisional {
		display: grid;
		justify-items: center;
		gap: var(--espacio-3);
		max-width: var(--ancho-contenido);
		margin-inline: auto;
		padding: var(--espacio-12) var(--margen-lateral);
		text-align: center;
	}

	h1 {
		font-size: var(--texto-2xl);
	}

	.eslogan {
		color: var(--color-rojo);
		font-weight: 700;
		font-size: var(--texto-lg);
	}

	a {
		display: inline-flex;
		align-items: center;
		min-height: var(--objetivo-tactil);
		font-weight: 600;
		color: var(--color-azul);
	}
</style>

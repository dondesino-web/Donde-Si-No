---
import { actions } from 'astro:actions';
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { obtenerBd } from '../../lib/db/index.ts';
import { formatearPrecio } from '../../lib/dominio/formato.ts';
import { listarCartaAdmin } from '../../lib/repositorios/adminCartaRepo.ts';

const AVISOS: Record<string, string> = { creado: 'Producto creado.', guardado: 'Cambios guardados.', eliminado: 'Producto eliminado.' };

// `Object.hasOwn`: un parámetro como ?aviso=constructor no debe encontrar propiedades heredadas.
const avisoDe = (clave: string | null): string | undefined => (clave !== null && Object.hasOwn(AVISOS, clave) ? AVISOS[clave] : undefined);

// Solo una acción se envía por petición: se muestra el resultado de la que corresponda.
const resultado = [
	actions.cambiarPrecio,
	actions.establecerDisponible,
	actions.moverProducto,
	actions.eliminarProducto,
	actions.guardarCategoria,
	actions.moverCategoria,
	actions.eliminarCategoria,
]
	.map((accion) => Astro.getActionResult(accion))
	.find((r) => r !== undefined);

const aviso = resultado?.data?.ok ? resultado.data.mensaje : avisoDe(Astro.url.searchParams.get('aviso'));
const errores = resultado?.data && !resultado.data.ok ? resultado.data.errores : undefined;
const errorGeneral = resultado?.error ? resultado.error.message : undefined;

const categorias = await listarCartaAdmin(obtenerBd());
---

<LayoutAdmin titulo="Carta">
	<h1>Carta</h1>

	<div aria-live="polite" class="avisos">
		{aviso && <p class="aviso aviso--ok" role="status">{aviso}</p>}
		{(errores || errorGeneral) && <p class="aviso aviso--error" role="alert">{Object.values(errores ?? {}).join(' ') || errorGeneral}</p>}
	</div>

	{
		categorias.map((categoria, indice) => (
			<section class="admin-categoria" aria-labelledby={`cat-${categoria.id}`}>
				<header class="admin-categoria__cabecera">
					<h2 id={`cat-${categoria.id}`}>
						{categoria.nombreEs}
						{!categoria.visible && <span class="insignia insignia--agotado">Oculta</span>}
					</h2>
					<div class="mover">
						<form method="POST" action={actions.moverCategoria}>
							<input type="hidden" name="id" value={categoria.id} />
							<input type="hidden" name="direccion" value="arriba" />
							<button type="submit" class="boton boton--icono boton--secundario" disabled={indice === 0} aria-label={`Subir la categoría ${categoria.nombreEs}`}>↑</button>
						</form>
						<form method="POST" action={actions.moverCategoria}>
							<input type="hidden" name="id" value={categoria.id} />
							<input type="hidden" name="direccion" value="abajo" />
							<button type="submit" class="boton boton--icono boton--secundario" disabled={indice === categorias.length - 1} aria-label={`Bajar la categoría ${categoria.nombreEs}`}>↓</button>
						</form>
					</div>
				</header>

				<ul class="admin-productos">
					{categoria.productos.map((p, i) => (
						<li class:list={['admin-producto', { 'admin-producto--agotado': !p.disponible || !p.visible }]}>
							<div class="admin-producto__info">
								<a class="admin-producto__nombre" href={`/admin/producto/${p.id}`}>{p.nombreEs}</a>
								<span class="admin-producto__estado">
									{!p.visible && 'Oculto · '}
									{!p.disponible && 'Agotado · '}
									{formatearPrecio(p.precio, 'es') ?? 'Consultar'}
								</span>
							</div>

							<form method="POST" action={actions.cambiarPrecio} class="admin-producto__precio">
								<input type="hidden" name="id" value={p.id} />
								<label class="solo-lectores" for={`precio-${p.id}`}>Precio de {p.nombreEs}</label>
								<input id={`precio-${p.id}`} name="precio" inputmode="numeric" autocomplete="off" placeholder="Consultar" value={p.precio ?? ''} />
								<button type="submit" class="boton boton--secundario">Guardar precio</button>
							</form>

							<form method="POST" action={actions.establecerDisponible}>
								<input type="hidden" name="id" value={p.id} />
								<input type="hidden" name="disponible" value={String(!p.disponible)} />
								<button type="submit" class:list={['boton', p.disponible ? 'boton--secundario' : 'boton--ok']}>
									{p.disponible ? 'Marcar agotado' : 'Volver a disponible'}
									<span class="solo-lectores"> {p.nombreEs}</span>
								</button>
							</form>

							<div class="mover">
								<form method="POST" action={actions.moverProducto}>
									<input type="hidden" name="id" value={p.id} />
									<input type="hidden" name="direccion" value="arriba" />
									<button type="submit" class="boton boton--icono boton--secundario" disabled={i === 0} aria-label={`Subir ${p.nombreEs}`}>↑</button>
								</form>
								<form method="POST" action={actions.moverProducto}>
									<input type="hidden" name="id" value={p.id} />
									<input type="hidden" name="direccion" value="abajo" />
									<button type="submit" class="boton boton--icono boton--secundario" disabled={i === categoria.productos.length - 1} aria-label={`Bajar ${p.nombreEs}`}>↓</button>
								</form>
							</div>
						</li>
					))}
				</ul>

				<div class="admin-categoria__pie">
					<a class="boton boton--secundario" href={`/admin/producto/nuevo?categoria=${categoria.id}`}>Agregar producto a {categoria.nombreEs}</a>
				</div>

				<details class="admin-categoria__editar">
					<summary>Editar categoría</summary>
					<form method="POST" action={actions.guardarCategoria} class="formulario">
						<input type="hidden" name="id" value={categoria.id} />
						<div class="campo">
							<label for={`cat-es-${categoria.id}`}>Nombre</label>
							<input id={`cat-es-${categoria.id}`} name="nombreEs" required maxlength="60" value={categoria.nombreEs} />
						</div>
						<div class="campo">
							<label for={`cat-en-${categoria.id}`}>Nombre en inglés</label>
							<input id={`cat-en-${categoria.id}`} name="nombreEn" maxlength="60" value={categoria.nombreEn ?? ''} />
						</div>
						<label class="casilla"><input type="checkbox" name="visible" checked={categoria.visible} /> Visible en la carta</label>
						<button type="submit" class="boton">Guardar categoría</button>
					</form>
					<form method="POST" action={actions.eliminarCategoria}>
						<input type="hidden" name="id" value={categoria.id} />
						<button type="submit" class="boton boton--peligro" data-confirmar={`¿Eliminar la categoría ${categoria.nombreEs}?`}>Eliminar categoría</button>
					</form>
				</details>
			</section>
		))
	}

	<section class="admin-categoria" aria-labelledby="nueva-categoria">
		<h2 id="nueva-categoria">Nueva categoría</h2>
		<form method="POST" action={actions.guardarCategoria} class="formulario">
			<div class="campo">
				<label for="nueva-es">Nombre</label>
				<input id="nueva-es" name="nombreEs" required maxlength="60" />
			</div>
			<div class="campo">
				<label for="nueva-en">Nombre en inglés <span class="campo__ayuda">(opcional)</span></label>
				<input id="nueva-en" name="nombreEn" maxlength="60" />
			</div>
			<label class="casilla"><input type="checkbox" name="visible" checked /> Visible en la carta</label>
			<button type="submit" class="boton">Crear categoría</button>
		</form>
	</section>
</LayoutAdmin>

<script>
	// Confirma las acciones destructivas sin depender de JavaScript para el resto del panel.
	document.addEventListener('submit', (evento) => {
		const boton = (evento as SubmitEvent).submitter as HTMLElement | null;
		const mensaje = boton?.dataset.confirmar;
		if (mensaje && !confirm(mensaje)) evento.preventDefault();
	});
</script>
